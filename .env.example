# Copia este archivo a .env y llena los valores. Nunca subas .env al repositorio.

# Token personal de Discogs (gratis): https://www.discogs.com/settings/developers
# Solo para desarrollo local. En la app, el token se guarda en la colección de la familia (Ajustes), nunca en el código.
VITE_DISCOGS_TOKEN=

# La nube familiar (Firebase) no usa variables: su configuración pública va en src/cloud/firebase-config.json.
# Para probar la nube sin cuenta, con el emulador local de Firebase corriendo (firebase/firebase.json):
# VITE_FIREBASE_EMULATOR=1
