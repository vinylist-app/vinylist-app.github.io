rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function col(cid) { return get(/databases/$(database)/documents/collections/$(cid)); }
    function isMember(cid) { return signedIn() && uid() in col(cid).data.members; }
    function isOwner(cid) { return signedIn() && col(cid).data.ownerUid == uid(); }

    // Perfil propio: nombre, correo y a qué colecciones pertenece.
    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // Un código de invitación: cualquiera con cuenta puede leerlo si conoce el código (no se puede listar).
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      // getAfter: al crear la colección, el código se guarda en el mismo lote que ella,
      // así que se revisa quién la administra tal como queda después del lote.
      allow create: if signedIn() && request.resource.data.createdBy == uid()
        && request.resource.data.collectionId is string
        && getAfter(/databases/$(database)/documents/collections/$(request.resource.data.collectionId)).data.ownerUid == uid();
      allow delete: if signedIn() && isOwner(resource.data.collectionId);
      allow update: if false;
    }

    match /collections/{cid} {
      allow get: if isMember(cid);
      // Para el selector de colecciones: solo las propias, nunca un listado general.
      allow list: if signedIn() && uid() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.members[uid()].role == 'owner'
        && request.resource.data.members.size() == 1;
      allow delete: if isOwner(cid);
      allow update: if signedIn() && (
        // Quien administra cambia lo que quiera (nombre, token de Discogs, código, miembros).
        resource.data.ownerUid == uid() && request.resource.data.ownerUid == resource.data.ownerUid
        // Un miembro cambia solo su propio nombre o se sale.
        || (uid() in resource.data.members
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([uid()]))
        // Alguien se une con un código válido de esta colección y solo se agrega a sí mismo.
        || (!(uid() in resource.data.members)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinCode'])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([uid()])
            && request.resource.data.members[uid()].role == 'editor'
            && request.resource.data.joinCode is string
            && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.collectionId == cid)
      );

      match /albums/{albumId} {
        allow read, write: if isMember(cid);
      }
      match /wishlist/{itemId} {
        allow read, write: if isMember(cid);
      }
    }
  }
}
